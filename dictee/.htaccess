# ====== Dictée NiderVoice (usage personnel) ======
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^lib(/|$) - [F,L]
</IfModule>
<FilesMatch "\.(sqlite|json|txt|md|bin|map)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  Header always set X-Robots-Tag "noindex, nofollow"
  # La dictée a besoin du micro sur ce site uniquement (remplace la règle générale qui l'interdit)
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()"
</IfModule>
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType text/javascript .mjs
</IfModule>
